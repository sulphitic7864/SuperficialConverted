{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Bundler",

    "outDir": "./dist",
    "rootDir": "./src",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },

  "include": [
    "src/**/*.ts"
  ],

  "exclude": [
    "src/shared",
    "node_modules",
    "dist"
  ]
}